tic(\n                "WARN",\n                relpath,\n                "dirty-document",\n                "uncommitted modifications; the bundle carries the committed revision",\n            )\n        revisions.append((relpath, sha))\n    return revisions\n\n\ndef render_directive(heading, date, revisions):\n    lines = [heading, "", "Date: %s" % date, "Documents in scope:"]\n    lines += ["- %s @ %s" % (relpath, sha) for relpath, sha in revisions]\n    lines += [\n        "",\n        "## Decisions",\n        "",\n        PLACEHOLDER_DECISION,\n        "",\n        "## Deferred / out of scope",\n        "",\n        "- <item> — <where it is tracked>",\n        "",\n        "## Execution notes",\n        "",\n        "<constraints on how edits are made, if any>",\n        "",\n    ]\n    return "\\n".join(lines)\n\n\ndef write_bundle(root, outdir, revisions, directive_relpath):\n    outdir.mkdir(parents=True, exist_ok=True)\n    manifest = []\n    for relpath, sha in revisions:\n        content = repo.file_at_rev(root, sha, relpath)\n        if content is None:\n            raise cli.ToolError(\n                "cannot read %s at %s" % (relpath, sha), cli.EXIT_PRECONDITION\n            )\n        (outdir / relpath.replace("/", "__")).write_text(content, encoding=cli.ENCODING)\n        manifest.append("%s @ %s" % (relpath, sha))\n    manifest.append(directive_relpath)\n    (outdir / "BUNDLE.txt").write_text(\n        "\\n".join(manifest) + "\\n", encoding=cli.ENCODING\n    )\n\n\ndef main(argv=None):\n    args = build_parser().parse_args(argv)\n    if bool(args.cycle) == bool(args.name):\n        raise cli.ToolError(\n            "exactly one of --cycle or --name is required", cli.EXIT_USAGE\n        )\n\n    root = cli.load_root()\n    # AC-CO-12: `--out` is repo-relative, always. Resolved before anything is\n    # written, so a refused run leaves no directive behind either.\n    out_rel = cli.repo_relative_path(root, args.out, "--out") if args.out else None\n   