#!/usr/bin/env python3
"""R0720 (DEC-001350): after any `git push`, fetch the remote and print the
ref's SHA; fail loudly when it differs from what was sent. `PostToolUse` on
`Bash`; a command that is not a push passes silently. The evidence printed
is what R0172 obliges the session to cite."""

import os
import re
import shlex
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _hooklib as lib  # noqa: E402

PUSH_RE = re.compile(
    r"(^|[;&|]\s*|\s)git(\s+(-C\s+\S+|-c\s+\S+|--\S+|-\S))*\s+push(\s|$)")
REDIRECT_RE = re.compile(r"^(\d*[<>]|&>)")
SKIP_FLAGS = ("--delete", "-d", "--tags", "--mirror", "--all", "--dry-run", "-n")


def _pushes(command):
    """`[(remote, refspec, chdir)]` for each `git push` in the command; `remote`
    is `None` when the push names none, `chdir` the `-C <dir>` values before
    `push`, in order."""
    found = []
    for segment in re.split(r"&&|\|\||;|\|", command):
        if not PUSH_RE.search(segment):
            continue
        try:
            words = shlex.split(segment)
        except ValueError:
            words = segment.split()
        chdir = []
        index = None
        for start, word in enumerate(words):
            if word != "git":
                continue
            probe = start + 1
            while probe < len(words) and words[probe] != "push":
                if words[probe] in ("-C", "-c") and probe + 1 < len(words):
                    if words[probe] == "-C":
                        chdir.append(words[probe + 1])
                    probe += 2
                elif words[probe].startswith("-"):
                    probe += 1
                else:
                    break
            if probe < len(words) and words[probe] == "push":
                index = probe
                break
        if index is None:
            continue
        args = [w for w in words[index + 1:]]
        if any(flag in args for flag in SKIP_FLAGS):
            continue
        positional = []
        skip_next = False
        for word in args:
            if skip_next:
                skip_next = False
                continue
            if word in ("-o", "--push-option", "--receive-pack", "--exec", "--repo"):
                skip_next = True
                continue
            if word.startswith("-") or REDIRECT_RE.match(word):
                continue
            positional.append(word)
        remote = positional[0] if positional else None
        refspecs = positional[1:] or [None]
        for refspec in refspecs:
            found.append((remote, refspec, chdir))
    return found


def main():
    data = lib.read_input()
    command = (data.get("tool_input") or {}).get("command") or ""
    pushes = _pushes(command)
    if not pushes:
        lib.passthrough()
    failures = []
    lines = []
    for remote, refspec, chdir in pushes:
        base = lib.cwd_of(data)
        for directory in chdir:
            base = base / os.path.expanduser(directory)
        root = lib.repo_root(base)
        if root is None:
            lib.block("push-readback: a git push ran outside any repository I can read back")
        branch = lib.current_branch(root)
        if remote is None:
            _, configured, _ = lib.git(root, "config", "branch.%s.remote" % branch)
            remote = configured.strip() or "origin"
        if refspec is None:
            src = dst = branch
        elif ":" in refspec:
            src, dst = refspec.split(":", 1)
        else:
            src = dst = refspec
        src = src.lstrip("+")
        if dst == "HEAD":
            dst = branch
        if dst.startswith("refs/heads/"):
            dst = dst[len("refs/heads/"):]
        code, _, err = lib.git(root, "fetch", "-q", remote, dst)
        if code != 0:
            failures.append("fetch %s %s failed: %s" % (remote, dst, err.strip()))
            continue
        _, local, _ = lib.git(root, "rev-parse", src)
        _, remote_sha, _ = lib.git(root, "rev-parse", "FETCH_HEAD")
        local, remote_sha = local.strip(), remote_sha.strip()
        lines.append("push-readback: %s/%s is at %s" % (remote, dst, remote_sha))
        if local != remote_sha:
            failures.append("%s/%s reads back %s; local %s is %s"
                            % (remote, dst, remote_sha, src, local))
    for line in lines:
        print(line)
    if failures:
        lib.block("push-readback: " + "; ".join(failures))
    lib.passthrough()


if __name__ == "__main__":
    main()
