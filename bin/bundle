#!/usr/bin/env python3
"""Compute the reference closure from entry-point context-sets.

Contract: `docs/packages/package-a-spec.md` §3.7.

Edges are (a) `depends-on:` frontmatter entries resolved to
`context-sets/<name>.md` and (b) backticked repo-relative `*.md` paths in the
body that exist as files. Only declared `depends-on` edges are strict: a
backticked string that is not a repo file is prose, not a broken reference.
"""

import argparse
import datetime
import json
import os
import pathlib
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from aimeta import cli, closure, frontmatter, repo  # noqa: E402

# ============================================================================
# STUB FOR bundle-audience-tests-2 (Test Designer red run) — TEST-ONLY.
#
# Everything between this banner and its closing counterpart below exists
# only to give bin/tests/test_bundle_audience.py a red run that fails on
# assertions rather than on argparse/import errors. It is deliberately wrong
# on AC-BA-1 (governed set omits docs/global-context/**, engagements/**,
# prose-criteria.md), AC-BA-2 (membership is literal-value-only: no
# all-roles/all-decision-roles expansion), AC-BA-3 (order ignores `order:`,
# sorts by path only), AC-BA-4 (no header stamp, no bundle-methodology-shaped
# separators, --out is ignored), AC-BA-5 (--list omits the reserved values),
# and AC-BA-6 (no validation: any --audience value "succeeds"). AC-BA-7 is
# untouched by omission: the positional closure mode below is unmodified, so
# it still exits 0, which is itself the wrong behaviour AC-BA-7's tests
# expect to fail on.
#
# The Coder replaces this entire block (and the --audience/--list wiring in
# build_parser() and main() below) with a real implementation of AC-BA-1..8;
# nothing in this block is meant to survive.


def _stub_governed_files(root):
    """AC-BA-1, deliberately incomplete: check-frontmatter's glob scan only."""
    ctx = cli.load_context()
    return cli.in_scope_files(ctx)


def _stub_audience_values(root, relpath):
    text, finding = cli.read_document(root / relpath)
    if finding is not None:
        return []
    doc = frontmatter.parse_text(text)
    value = doc.fields.get("audience")
    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        return list(value)
    return [value]


def _stub_list(root):
    """AC-BA-5, deliberately incomplete: no reserved values are added."""
    values = set()
    for relpath in _stub_governed_files(root):
        values.update(_stub_audience_values(root, relpath))
    for value in sorted(values):
        print(value)
    return cli.EXIT_OK


def _stub_audience(root, value):
    """AC-BA-2/3/4/6, deliberately wrong: literal membership only, `order:`
    ignored in favor of (length, path) descending, no header/separators, no
    --out support, no validation."""
    matches = [
        relpath
        for relpath in _stub_governed_files(root)
        if value in _stub_audience_values(root, relpath)
    ]
    for relpath in sorted(matches, key=lambda r: (len(r), r), reverse=True):
        print(relpath)
    return cli.EXIT_OK


# ============================================================================
# END STUB FOR bundle-audience-tests-2.


def build_parser():
    p = argparse.ArgumentParser(
        prog="bundle",
        description=(
            "Walk depends-on frontmatter and in-body document references to "
            "produce the full context set implied by an entry point."
        ),
    )
    p.add_argument("entries", nargs="*", metavar="ENTRY", help="context-set name or path")
    p.add_argument(
        "--format", choices=["list", "json", "concat"], default=None, help="output form"
    )
    p.add_argument("--max-depth", type=int, metavar="N", help="truncate the walk")
    p.add_argument("--why", action="store_true", help="annotate with referrer and depth")
    p.add_argument(
        "--strict", action="store_true", help="exit 1 on a dangling depends-on reference"
    )
    p.add_argument(
        "--write",
        action="store_true",
        help="render the concat form and write it to a file under --out DIR",
    )
    p.add_argument(
        "--out",
        default=None,
        metavar="DIR",
        help="directory to write the bundle into (only with --write; defaults to $HOME/Downloads)",
    )
    p.add_argument(
        "--audience",
        default=None,
        metavar="VALUE",
        help="[STUB] emit the governed-document bundle for an audience value",
    )
    p.add_argument(
        "--list",
        action="store_true",
        help="[STUB] list every known audience value",
    )
    return p


def render_concat(root, walked):
    """The `concat` form's text, per-document, exactly as `emit` prints it."""
    parts = []
    for item in walked:
        sha = repo.last_commit_sha(root, item["path"]) or "uncommitted"
        parts.append("===== %s @ %s =====\n" % (item["path"], sha))
        text, finding = cli.read_document(root / item["path"])
        if finding is not None:
            cli.diagnostic("WARN", item["path"], finding.code, finding.message)
            continue
        parts.append(text)
    return "".join(parts)


def emit(root, walked, fmt, why):
    if fmt == "json":
        print(json.dumps(walked, indent=2))
        return
    if fmt == "concat":
        print(render_concat(root, walked), end="")
        return
    for item in walked:
        if why and item["via"]:
            print("%s  <- %s (depth %d)" % (item["path"], item["via"], item["depth"]))
        else:
            print(item["path"])


def resolve_out_dir(argument):
    """`--out DIR`, tilde-expanded then resolved against the invoking cwd,
    matching `bundle-methodology`'s convention for a non-default value."""
    path = pathlib.Path(argument).expanduser()
    if not path.is_absolute():
        path = pathlib.Path.cwd() / path
    return path


def main(argv=None):
    args = build_parser().parse_args(argv)

    # STUB FOR bundle-audience-tests-2: --list / --audience short-circuit
    # before the (unmodified, AC-BA-7-violating) positional closure mode.
    if args.list:
        root = cli.load_root()
        return _stub_list(root)
    if args.audience is not None:
        root = cli.load_root()
        return _stub_audience(root, args.audience)
    if not args.entries:
        raise cli.ToolError(
            "an ENTRY, --audience VALUE, or --list is required", cli.EXIT_USAGE
        )
    # END STUB.

    if args.out is not None and not args.write:
        raise cli.ToolError("--out is only meaningful with --write", cli.EXIT_USAGE)
    if args.write and len(args.entries) > 1:
        raise cli.ToolError("--write accepts exactly one ENTRY, got %d" % len(args.entries), cli.EXIT_USAGE)
    if args.write and args.format is not None and args.format != "concat":
        raise cli.ToolError(
            "--write cannot be combined with --format %s (only concat)" % args.format,
            cli.EXIT_USAGE,
        )

    fmt = args.format
    if fmt is None:
        fmt = "concat" if args.write else "list"

    root = cli.load_root()
    entries = [closure.resolve_entry(root, entry) for entry in args.entries]
    dangling = []
    walked = closure.walk(root, entries, args.max_depth, dangling)

    if args.write:
        if dangling and args.strict:
            return cli.EXIT_POLICY
        text = render_concat(root, walked)
        entry_stem = pathlib.Path(entries[0]).stem
        stamp = datetime.datetime.now().strftime("%Y-%m-%d-%H%M")
        out_dir = (
            resolve_out_dir(args.out)
            if args.out is not None
            else pathlib.Path.home() / "Downloads"
        )
        out_dir.mkdir(parents=True, exist_ok=True)
        dest = out_dir / ("%s-context-bundle-%s.md" % (entry_stem, stamp))
        dest.write_text(text, encoding=cli.ENCODING)
        print("wrote %s" % dest.resolve())
    else:
        emit(root, walked, fmt, args.why)

    if dangling and args.strict:
        return cli.EXIT_POLICY
    return cli.EXIT_OK


if __name__ == "__main__":
    sys.exit(cli.run(main))
