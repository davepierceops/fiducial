#!/usr/bin/env python3
"""`bin/bundle --audience <value>` — audience-scoped governed-document bundle.

Contract: `docs/cycles/bundle-audience-tests-20260823T043025Z.md` and
`docs/cycles/bundle-audience-coder-20260823T045135Z.md` (including its
"Amendment 1"). AC-BA-1..8, as asserted by `bin/tests/test_bundle_audience.py`.
"""

from __future__ import annotations

import argparse
import datetime
import os
import pathlib
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from aimeta import cli, frontmatter, repo  # noqa: E402

REPO_NAME = "davepierceops/fiducial"

#: AC-BA-1: governed roots beyond check-frontmatter's configured globs.
GOVERNED_EXTRA_DIRS = ("docs/global-context", "engagements")
GOVERNED_EXTRA_FILES = ("prose-criteria.md",)

#: AC-BA-5: the three reserved audience values.
RESERVED_AUDIENCES = {"all-roles", "all-decision-roles", "human"}

BAR = "<!-- " + "=" * 60 + " -->"


def build_parser():
    p = argparse.ArgumentParser(
        prog="bundle",
        description=(
            "Render the governed-document bundle for an audience value, or "
            "list every valid audience value."
        ),
    )
    p.add_argument(
        "entries", nargs="*", metavar="ENTRY", help=argparse.SUPPRESS
    )
    p.add_argument(
        "--audience",
        default=None,
        metavar="VALUE",
        help="emit the governed-document bundle for an audience value",
    )
    p.add_argument(
        "--list",
        action="store_true",
        help="list every valid audience value, sorted, one per line",
    )
    p.add_argument(
        "--out",
        default=None,
        metavar="DIR",
        help="directory to write the bundle into (with --audience; default: stdout)",
    )
    return p


# ------------------------------------------------------------- governed set


def _walk_md_files(root, reldir):
    """Every `.md` file under `root/reldir`, repo-relative, slash-separated."""
    base = pathlib.Path(root) / reldir
    if not base.is_dir():
        return []
    found = []
    for dirpath, dirnames, filenames in os.walk(str(base)):
        dirnames[:] = [d for d in dirnames if d != ".git"]
        for name in filenames:
            if not name.endswith(".md"):
                continue
            rel = os.path.relpath(os.path.join(dirpath, name), str(root))
            found.append(rel.replace(os.sep, "/"))
    return found


def governed_files(ctx):
    """AC-BA-1: the governed file set, sorted."""
    files = set(cli.in_scope_files(ctx))
    for reldir in GOVERNED_EXTRA_DIRS:
        files.update(_walk_md_files(ctx.root, reldir))
    for relfile in GOVERNED_EXTRA_FILES:
        if (pathlib.Path(ctx.root) / relfile).is_file():
            files.add(relfile)
    return sorted(files)


def _document(root, relpath):
    """Parsed `frontmatter.Document` for `relpath`, or `None` if unreadable."""
    text, finding = cli.read_document(pathlib.Path(root) / relpath)
    if finding is not None:
        return None
    return frontmatter.parse_text(text)


def audience_values(root, relpath):
    """AC-BA-2: `relpath`'s `audience:` values, as a list."""
    doc = _document(root, relpath)
    if doc is None:
        return []
    value = doc.fields.get("audience")
    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        return list(value)
    return [value]


def order_value(root, relpath):
    """AC-BA-3: `relpath`'s `order:` value as an int, or `None`."""
    doc = _document(root, relpath)
    if doc is None:
        return None
    raw = doc.fields.get("order")
    if raw is None:
        return None
    try:
        return int(raw)
    except (TypeError, ValueError):
        return None


# ---------------------------------------------------------------- AC-BA-2


def _role_document_path(root, slug):
    """The role document for `slug` under `roles/`/`engagements/`, or `None`.

    Scans `root`'s own trees directly with `repo._is_role_document` rather
    than going through `repo.role_slugs` — that helper only inspects a base's
    `engagements/` when the same base also has a `roles/` dir, and falls back
    to the methodology home otherwise, which would wrongly miss an
    engagements-only role document in the invoking repo.
    """
    for candidate in (
        pathlib.Path(root) / "roles" / ("%s.md" % slug),
        pathlib.Path(root) / "engagements" / ("%s.md" % slug),
        pathlib.Path(root) / "engagements" / "sre" / ("%s.md" % slug),
    ):
        if candidate.is_file() and repo._is_role_document(candidate):
            return candidate
    return None


def local_role_slugs(root):
    """AC-BA-5: basename slugs of every role document under `root`'s own
    `roles/`/`engagements/`/`engagements/sre/`, independent of
    `repo.role_slugs`'s methodology-home fallback (see `_role_document_path`)."""
    root = pathlib.Path(root)
    slugs = set()
    roles_dir = root / "roles"
    if roles_dir.is_dir():
        slugs |= {p.stem for p in roles_dir.glob("*.md") if repo._is_role_document(p)}
    for engagements_dir in (root / "engagements", root / "engagements" / "sre"):
        if engagements_dir.is_dir():
            slugs |= {
                p.stem for p in engagements_dir.glob("*.md") if repo._is_role_document(p)
            }
    return slugs


def _is_decision_role(ctx, slug):
    """True when `slug` names a role document whose `session:` is `decision`."""
    path = _role_document_path(ctx.root, slug)
    if path is None:
        return False
    doc = _document(ctx.root, os.path.relpath(str(path), str(ctx.root)))
    if doc is None:
        return False
    return doc.fields.get("session") == "decision"


def is_member(ctx, relpath, value):
    """AC-BA-2: whether `relpath` is a member of bundle `value`."""
    values = audience_values(ctx.root, relpath)
    if value in values:
        return True
    if "all-roles" in values:
        return True
    if "all-decision-roles" in values and _is_decision_role(ctx, value):
        return True
    return False


# ---------------------------------------------------------------- AC-BA-3


def _sort_key(root, relpath):
    order = order_value(root, relpath)
    if order is None:
        return (1, 0, relpath)
    return (0, order, relpath)


def ordered_members(ctx, value):
    return sorted(
        (relpath for relpath in governed_files(ctx) if is_member(ctx, relpath, value)),
        key=lambda relpath: _sort_key(ctx.root, relpath),
    )


# ---------------------------------------------------------------- AC-BA-4


def resolve_out_dir(argument):
    """`--out DIR`, tilde-expanded then resolved against the invoking cwd."""
    path = pathlib.Path(argument).expanduser()
    if not path.is_absolute():
        path = pathlib.Path.cwd() / path
    return path


def render_bundle(ctx, value, members):
    """AC-BA-4: the self-contained bundle document for `value`."""
    repo_sha = repo.git("rev-parse", "HEAD", cwd=ctx.root)
    generated = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    count = len(members)

    shas = {}
    bodies = {}
    for relpath in members:
        sha = repo.short_blob_sha(ctx.root, "HEAD", relpath)
        body = repo.file_at_rev(ctx.root, "HEAD", relpath)
        shas[relpath] = sha if sha is not None else "uncommitted"
        bodies[relpath] = body if body is not None else ""

    lines = [
        "# bundle-%s\n" % value,
        "- Repo: %s" % REPO_NAME,
        "- HEAD: %s" % repo_sha,
        "- Generated: %s" % generated,
        "- Files:\n",
    ]
    lines += [
        "  %d. %s (blob %s)" % (i, relpath, shas[relpath])
        for i, relpath in enumerate(members, 1)
    ]
    lines.append("")
    for i, relpath in enumerate(members, 1):
        lines += [
            "",
            BAR,
            "<!-- FILE %d/%d: %s @ %s -->" % (i, count, relpath, shas[relpath]),
            BAR,
            "",
            bodies[relpath].rstrip("\n"),
            "",
        ]
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------- AC-BA-5/6


def known_audience_values(ctx):
    """AC-BA-5 (Amendment 1): role-doc slugs, reserved values, and every
    literal `audience:` value present in any governed file."""
    values = set(RESERVED_AUDIENCES)
    values |= local_role_slugs(ctx.root)
    for relpath in governed_files(ctx):
        values.update(audience_values(ctx.root, relpath))
    return values


def cmd_list(ctx):
    for value in sorted(known_audience_values(ctx)):
        print(value)
    return cli.EXIT_OK


def cmd_audience(ctx, value, out):
    known = known_audience_values(ctx)
    if value not in known:
        raise cli.ToolError(
            "unknown audience value %r (see `bundle --list`)" % value, cli.EXIT_USAGE
        )
    members = ordered_members(ctx, value)
    text = render_bundle(ctx, value, members)
    if out is None:
        print(text, end="")
        return cli.EXIT_OK
    out_dir = resolve_out_dir(out)
    out_dir.mkdir(parents=True, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
    dest = out_dir / ("bundle-%s-%s.md" % (value, stamp))
    dest.write_text(text, encoding=cli.ENCODING)
    return cli.EXIT_OK


# ---------------------------------------------------------------------- main


def main(argv=None):
    args = build_parser().parse_args(argv)

    if args.list:
        return cmd_list(cli.load_context())

    if args.audience is not None:
        return cmd_audience(cli.load_context(), args.audience, args.out)

    # AC-BA-7: the positional path-following closure mode is removed.
    raise cli.ToolError(
        "an ENTRY is no longer accepted; use --audience VALUE or --list",
        cli.EXIT_USAGE,
    )


if __name__ == "__main__":
    sys.exit(cli.run(main))
