#!/usr/bin/env python3
"""`bin/bundle` — the rule-store bundle command.

Contract: `docs/cycles/bundle-tool-tests-20260906T110000Z.md` § "INTERFACE
CONTRACT", landed at `d5b643b48cf0285194d29b09f6755db1b8a16b34`; amended by
`docs/cycles/bundle-tool-followup-20260907T170000Z.md` items 4 (sequence-
ordered selection), 5 (the one-line header) and 7 (Q5 plain imports, Q6/Q8/
Q9/Q11/S8/S12 refusals); `--emit` added by the subtraction plan's package 3a
(SPEC.md §7). Four modes:

    bin/bundle --where k=v [k=v ...] [--name NAME] [--out DIR]
    bin/bundle --emit TARGET --out DIR [--where k=v ...] [--name NAME]
    bin/bundle --keys
    bin/bundle --near "TEXT"

`--where` refuses (exit 2, one line on stderr, nothing written) on a
malformed query, a `--name` that would escape `--out`, a malformed row, or an
empty selection; otherwise it writes exactly one file and prints its path
(exit 0). It renders the local tree as it stands — no sync check, no
clean-tree check (DEC-000940); only `bin/release` checks origin. `--keys` and
`--near` always exit 0.

`--emit TARGET` renders the local tree as it stands — no sync check, no
clean-tree check (DEC-000940) — through one target of `rulestore.emit`
(`bundle`, `claude-code`; see that package's docstring for the interface),
writes the target's files under `--out` and prints each path written; a
refusal is exit 2, one line on stderr, nothing written. `--emit bundle`
needs `--where` and writes the same file `--where` writes; `--emit
claude-code` takes no query.
"""

from __future__ import annotations

import argparse
import datetime
import hashlib
import os
import pathlib
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from rulestore import emit as emit_mod
from rulestore import keys as keys_mod
from rulestore import named_queries
from rulestore import near as near_mod
from rulestore import query
from rulestore import render
from rulestore import store as store_mod
from rulestore import terms
from rulestore.store import FileRowSource

EXIT_OK = 0
EXIT_REFUSED = 2


def _git(root, *args):
    return subprocess.run(
        ["git", *args], cwd=str(root), capture_output=True, text=True,
    )


def _repo_root():
    """The repository root, or `None` outside a git repository."""
    proc = _git(pathlib.Path.cwd(), "rev-parse", "--show-toplevel")
    if proc.returncode != 0:
        return None
    return pathlib.Path(proc.stdout.strip())


def _repo_label(root):
    proc = _git(root, "config", "--get", "remote.origin.url")
    url = proc.stdout.strip()
    if not url:
        return str(root)
    if url.endswith(".git"):
        url = url[: -len(".git")]
    parts = url.replace(":", "/").rstrip("/").split("/")
    return "/".join(parts[-2:]) if len(parts) >= 2 else url


def _head(root):
    proc = _git(root, "rev-parse", "HEAD")
    return proc.stdout.strip() if proc.returncode == 0 else None


def _local_head(root):
    """HEAD, or `<HEAD>+local.<12 hex>` when a generation input differs from
    it (#366): the hex is SHA-256 over the sorted `(path, file hash or
    "deleted")` pairs of the changed inputs, README.md excluded."""
    head = _head(root)
    paths = [p for p in store_mod.dirty_input_paths(root) if p != "README.md"]
    if head is None or not paths:
        return head
    pairs = []
    for relpath in paths:
        path = root / relpath
        digest = hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else "deleted"
        pairs.append("%s\0%s\n" % (relpath, digest))
    return "%s+local.%s" % (head, hashlib.sha256("".join(pairs).encode()).hexdigest()[:12])


def build_parser():
    parser = argparse.ArgumentParser(prog="bundle")
    parser.add_argument("--where", nargs="+", metavar="K=V")
    parser.add_argument("--keys", action="store_true")
    parser.add_argument("--near", metavar="TEXT")
    parser.add_argument("--emit", metavar="TARGET")
    parser.add_argument("--name")
    parser.add_argument("--out")
    return parser


def _mode(args, parser):
    """Exactly one of `--keys`, `--near`, `--where`, `--emit` — except that
    `--emit` may carry `--where` as its query."""
    chosen = [name for name in ("keys", "near", "where", "emit")
              if getattr(args, name) not in (None, False)]
    if "emit" in chosen:
        chosen = [name for name in chosen if name != "where"]
    if len(chosen) != 1:
        parser.error("one of --keys, --near, --where, --emit is required")
    return chosen[0]


def refuse(message):
    print(message, file=sys.stderr)
    return EXIT_REFUSED


def cmd_keys(root):
    try:
        rows = FileRowSource(root).rows()
    except store_mod.RowShapeError as exc:
        return refuse("refused: %s" % exc)
    census = keys_mod.keys_in_use(rows)
    for key in sorted(census):
        for value in sorted(census[key]):
            print("%s=%s %d" % (key, value, census[key][value]))
    return EXIT_OK


def cmd_near(root, text):
    try:
        rows = FileRowSource(root).rows()
    except store_mod.RowShapeError as exc:
        return refuse("refused: %s" % exc)
    for row, score in near_mod.near(text, rows):
        print("%s %.2f" % (render._heading(row), score))
    return EXIT_OK


def cmd_where(root, tokens, name, out):
    try:
        where = query.parse_where(tokens)
    except query.QueryError as exc:
        return refuse("refused: %s" % exc)

    if name and ("/" in name or "\\" in name or ".." in name):
        return refuse("refused: --name must not contain a path separator or ..: %r" % name)

    try:
        source = FileRowSource(root)
        rows = source.rows()
    except store_mod.RowShapeError as exc:
        return refuse("refused: %s" % exc)
    sequences = named_queries.sequences(source.named_queries_text())
    selected = query.select(rows, where, sequences)
    if not selected:
        return refuse("refused: the query selected no rows")

    definitions = terms.pull_definitions(selected, rows)
    generated = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    text = render.render(
        selected, definitions,
        repo=_repo_label(root), head=_local_head(root), generated=generated,
    )

    bundle_name = name or "-".join("%s-%s" % (k, v) for k, v in where.items())
    out_dir = pathlib.Path(out).expanduser() if out else pathlib.Path.home() / "Downloads"
    out_dir.mkdir(parents=True, exist_ok=True)
    dest = out_dir / ("fiducial-bundle-%s-%s.md" % (bundle_name, generated))
    dest.write_text(text, encoding="utf-8")
    print(str(dest))
    return EXIT_OK


def _hook_scripts(root):
    """`{name: text}` for every file under `bin/hooks/` of the store repo."""
    hooks_dir = root / "bin" / "hooks"
    found = {}
    if hooks_dir.is_dir():
        for path in sorted(hooks_dir.iterdir()):
            if path.is_file():
                found[path.name] = path.read_text(encoding="utf-8")
    return found


def cmd_emit(root, target_name, tokens, name, out):
    registry = emit_mod.targets()
    target = registry.get(target_name)
    if target is None:
        return refuse("refused: no emit target %r; targets: %s"
                      % (target_name, ", ".join(sorted(registry))))
    where = None
    if tokens:
        try:
            where = query.parse_where(tokens)
        except query.QueryError as exc:
            return refuse("refused: %s" % exc)
    if target.takes_query == "required" and where is None:
        return refuse("refused: --emit %s needs --where" % target_name)
    if target.takes_query == "none" and where is not None:
        return refuse("refused: --emit %s takes no --where" % target_name)
    if name and ("/" in name or "\\" in name or ".." in name):
        return refuse("refused: --name must not contain a path separator or ..: %r" % name)
    if not out:
        return refuse("refused: --emit needs --out DIR")

    try:
        source = FileRowSource(root)
        rows = source.rows()
        tiers = emit_mod.load_tiers()
    except (store_mod.RowShapeError, emit_mod.EmitError) as exc:
        return refuse("refused: %s" % exc)
    sequences = named_queries.sequences(source.named_queries_text())
    generated = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    inputs = emit_mod.EmitInputs(
        rows=rows, sequences=sequences, where=where, name=name,
        repo=_repo_label(root),
        head=_local_head(root) if target_name == "bundle" else _head(root),
        generated=generated, tiers=tiers, hooks=_hook_scripts(root),
    )
    try:
        emission = target.emit(inputs)
    except emit_mod.EmitError as exc:
        return refuse(str(exc) if str(exc).startswith("refused") else "refused: %s" % exc)

    out_dir = pathlib.Path(out).expanduser()
    out_dir.mkdir(parents=True, exist_ok=True)
    for relpath in sorted(emission.files):
        dest = out_dir / relpath
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(emission.files[relpath], encoding="utf-8")
        if relpath in emission.executable:
            dest.chmod(dest.stat().st_mode | 0o111)
        print(str(dest))
    for note in emission.notes:
        print(note if note.startswith("warning:") else "note: %s" % note, file=sys.stderr)
    return EXIT_OK


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    mode = _mode(args, parser)
    root = _repo_root()
    if root is None:
        return refuse("refused: not inside a git repository")
    if not (root / "rules").is_dir() and not (root / "process").is_dir():
        return refuse("refused: no rules/ or process/ under %s" % root)
    if mode == "keys":
        return cmd_keys(root)
    if mode == "near":
        return cmd_near(root, args.near)
    if mode == "emit":
        return cmd_emit(root, args.emit, args.where, args.name, args.out)
    return cmd_where(root, args.where, args.name, args.out)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
