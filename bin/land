#!/usr/bin/env python3
"""THROWAWAY TEST STUB — NOT AN IMPLEMENTATION. DELETE AND REWRITE WHOLESALE.

=============================================================================
 THIS FILE IS A TEST FIXTURE WRITTEN BY THE TEST DESIGNER, NOT PRODUCTION CODE.
 It exists so `bin/tests/test_land.py` executes against a real process and
 fails on *bad logic* rather than on "no such file". It is DELIBERATELY WRONG.
 It is not a partial implementation and must never be extended into one. The
 Coder replaces this whole file with the real `bin/land` of
 `specs/bin-land-trd.md` §3.1, §3.2 and §7.
=============================================================================

How it is deliberately wrong:

- **The report is written to stdout before the arguments are validated.** So a
  usage error still writes a report, which is exactly what AC-LAND-T01a says
  must not happen (§3.2 step 11: "stdout carries nothing and no report is
  emitted"). This is the shape OQ-4's "emit early" temptation would take.
- The argv it reports on is a crude positional peek, not `argparse`'s answer.
- The exit code comes from `report.py`'s fabricated rule, not from §7's
  mapping, so nothing here maps a failure mode onto an exit status.
- `aimeta/land.py` runs no git, so there is no landing to report on.

What it deliberately gets right, so the tests fail on behaviour rather than on
scaffolding: the `argparse` surface of §3.2 step 1, the `sys.path.insert`
idiom the other seven executables use, and §5.2's serialization.
"""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from aimeta import cli, land as land_module  # noqa: E402


def build_parser():
    p = argparse.ArgumentParser(
        prog="land",
        description=(
            "Land a commit on a branch at origin and verify what landed. "
            "STUB: this build performs no landing."
        ),
    )
    p.add_argument("branch", metavar="BRANCH", help="branch to land on")
    p.add_argument("message", metavar="MESSAGE", help="commit message")
    p.add_argument(
        "files", metavar="FILE", nargs="*", help="paths to stage; all changes if none"
    )
    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    # DELIBERATE DEFECT (AC-LAND-T01a): emitted before validation.
    positional = [a for a in argv if not a.startswith("-")]
    report = land_module.land(
        branch=positional[0] if positional else None,
        message=positional[1] if len(positional) > 1 else "",
        paths=positional[2:],
        cwd=os.getcwd(),
    )
    sys.stdout.write(report.to_json())

    build_parser().parse_args(argv)
    return report.exit_code()


if __name__ == "__main__":
    sys.exit(cli.run(main))
