#!/usr/bin/env python3
"""Assemble a directive skeleton from committed governed regions.

Contract: `specs/directive-tooling.md` §6 and `specs/directive-tooling-trd.md`
§3.2, §3.3, §3.9, §6, §7. Two modes: general mode, every directive class that
is not a reviewer-gated cycle, and cycle mode, which is `bin/cycle-open`'s
surface after the G0 migration (§3.9 step 4): `bin/cycle-open` forwards its
argv to the same entry point, `aimeta.directive.main`.

No region text lives in this file. Every region is addressed by its section
name in the invariants document, and every marker is the first line of that
section's committed body.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from aimeta import cli, directive  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.run(directive.main))
