#!/usr/bin/env python3
"""`bin/release` — cut a release: README.md plus one bundle per entry of
`process/named-queries.md`'s list, all generated at HEAD (DEC-000660).

    bin/release [--tag TAG] [--out DIR]

Refuses (exit 2, one line on stderr, nothing written) outside a git
repository, in a repository with neither `rules/` nor `process/`, on any
uncommitted change under a generation input (`store.INPUT_ROOTS`; README.md
included, since it is generated from the working tree), when the fetch of
`origin main` fails, when `remote.origin.url` is no GitHub URL, when HEAD is
not `origin/main`, when `README.md` is absent at the root, when `--tag`
already exists on origin, when `--out` exists, when the bundle list is
empty, or when a generated bundle lacks a selected rule row or carries a
retired row's text. On any per-entry `bin/bundle` failure it refuses whole
and removes everything it wrote.

Contract: `docs/cycles/bundle-tool-followup-20260907T170000Z.md`, item 6.
"""

from __future__ import annotations

import argparse
import datetime
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from rulestore import named_queries
from rulestore import query
from rulestore import render
from rulestore import store as store_mod
from rulestore.store import FileRowSource

EXIT_OK = 0
EXIT_REFUSED = 2

BUNDLE_BIN = pathlib.Path(__file__).resolve().parent / "bundle"


def _git(root, *args):
    return subprocess.run(
        ["git", *args], cwd=str(root), capture_output=True, text=True,
    )


def _repo_root():
    proc = _git(pathlib.Path.cwd(), "rev-parse", "--show-toplevel")
    if proc.returncode != 0:
        return None
    return pathlib.Path(proc.stdout.strip())


def _head(root):
    proc = _git(root, "rev-parse", "HEAD")
    return proc.stdout.strip() if proc.returncode == 0 else None


GITHUB_URL_RE = re.compile(
    r"^(?:https://(?:[^@/]+@)?|ssh://(?:[^@/]+@)?|git@)github\.com[:/]"
    r"([^/\s]+)/([^/\s]+?)(?:\.git)?/?$")


def _github_repo(root):
    """`owner/repo` from `remote.origin.url`, or `None` if it is no GitHub URL."""
    url = _git(root, "config", "--get", "remote.origin.url").stdout.strip()
    match = GITHUB_URL_RE.match(url)
    return "%s/%s" % match.groups() if match else None


def _body_problem(name, tokens, text, rows, retired, sequences):
    """A refusal line if the generated bundle `text` lacks a selected rule row
    or carries a retired row's text, else `None` (#381 C2)."""
    selected = query.select(rows, query.parse_where(tokens), sequences)
    for row in selected:
        rendered = render.row_text(row)
        if row.kind == "rule" and rendered and rendered not in text:
            return "refused: %s: selected row %s is missing from the generated bundle" % (name, row.id)
    live = {render.row_text(row) for row in selected if row.kind == "rule"}
    rest = text
    for row in selected:
        if row.kind == "process" and render.row_text(row):
            rest = rest.replace(render.row_text(row), "")
    for row in retired:
        rendered = render.row_text(row)
        if rendered and rendered in rest and rendered not in live:
            return "refused: %s: retired row %s appears in the generated bundle" % (name, row.id)
    return None


def refuse(message):
    print(message, file=sys.stderr)
    return EXIT_REFUSED


def default_tag():
    today = datetime.datetime.now(datetime.timezone.utc)
    return "v%04d.%02d.%02d" % (today.year, today.month, today.day)


def build_parser():
    parser = argparse.ArgumentParser(prog="release")
    parser.add_argument("--tag")
    parser.add_argument("--out")
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    tag = args.tag or default_tag()

    root = _repo_root()
    if root is None:
        return refuse("refused: not inside a git repository")

    if not (root / "rules").is_dir() and not (root / "process").is_dir():
        return refuse("refused: no rules/ or process/ under %s" % root)

    dirty = store_mod.dirty_input_paths(root)
    if dirty:
        return refuse("refused: uncommitted changes to generation inputs: %s" % ", ".join(dirty))

    if _git(root, "fetch", "-q", "origin", "main").returncode != 0:
        return refuse("refused: could not fetch origin/main")

    github = _github_repo(root)
    if github is None:
        return refuse("refused: remote.origin.url is not a GitHub URL")

    head = _head(root)
    upstream_proc = _git(root, "rev-parse", "origin/main")
    upstream = upstream_proc.stdout.strip() if upstream_proc.returncode == 0 else None
    if head is None or head != upstream:
        return refuse("refused: HEAD is not origin/main")

    readme = root / "README.md"
    if not readme.is_file():
        return refuse("refused: README.md is missing at %s" % root)

    if _git(root, "ls-remote", "--tags", "origin", tag).stdout.strip():
        return refuse("refused: tag %s already exists on origin" % tag)

    out_dir = (
        pathlib.Path(args.out).expanduser() if args.out
        else pathlib.Path.home() / "Downloads" / ("fiducial-release-%s" % tag)
    )
    if out_dir.exists():
        return refuse("refused: --out already exists: %s" % out_dir)

    if not (root / "process" / "named-queries.md").is_file():
        return refuse("refused: no process/named-queries.md under %s" % root)

    entries = named_queries.bundles(FileRowSource(root).named_queries_text())
    if not entries:
        return refuse("refused: the bundle list is empty")

    names = [name for name, _ in entries]
    duplicate = next((name for name in names if names.count(name) > 1), None)
    if duplicate is not None:
        return refuse("refused: the bundle list repeats the name %r" % duplicate)

    source = FileRowSource(root)
    try:
        rows = source.rows()
        retired = source.retired_rows()
    except store_mod.RowShapeError as exc:
        return refuse("refused: %s" % exc)
    sequences = named_queries.sequences(source.named_queries_text())

    scratch = pathlib.Path(tempfile.mkdtemp(prefix="fiducial-release-"))
    try:
        written = []
        for name, tokens in entries:
            proc = subprocess.run(
                [sys.executable, str(BUNDLE_BIN), "--where", *tokens,
                 "--name", name, "--out", str(scratch)],
                cwd=str(root), capture_output=True, text=True,
            )
            if proc.returncode != 0:
                print("refused: %s: bin/bundle exited %d" % (name, proc.returncode),
                      file=sys.stderr)
                return EXIT_REFUSED
            path = pathlib.Path(proc.stdout.strip())
            problem = _body_problem(name, tokens, path.read_text(encoding="utf-8"),
                                    rows, retired, sequences)
            if problem:
                return refuse(problem)
            written.append((name, path))

        out_dir.mkdir(parents=True)
        assets = [readme]
        for name, path in written:
            dest = out_dir / ("fiducial-bundle-%s.md" % name)
            shutil.copyfile(path, dest)
            assets.append(dest)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)

    print(str(out_dir))
    notes = "fiducial %s at %s" % (tag, head)
    print("gh release create -R %s %s --target %s --title %s --notes %s %s" % (
        shlex.quote(github), shlex.quote(tag), shlex.quote(head), shlex.quote(tag),
        shlex.quote(notes),
        " ".join(shlex.quote(str(asset)) for asset in assets),
    ))
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
