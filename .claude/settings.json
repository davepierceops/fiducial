{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/store-lint --check generated-filename",
            "type": "command"
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/store-lint --check citations",
            "type": "command"
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/store-lint --check verdict-lines",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-readback",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/intake-branch-guard",
            "type": "command"
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/decision-log-append-only",
            "type": "command"
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/review-artifact-immutable",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(~/.ssh/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets/**)",
      "Read(~/.aws/**)",
      "Bash(printenv*)",
      "Bash(cat *.env*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)",
      "Bash(pulumi up*)",
      "Bash(pulumi destroy*)",
      "Bash(gcloud * deploy*)",
      "Bash(gcloud run deploy*)",
      "Bash(aws * deploy*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(ssh *prod*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * -f*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push origin +*)",
      "Bash(git push * +*)"
    ]
  }
}
